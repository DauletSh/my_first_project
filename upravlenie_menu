def find_user(name):
    if name.strip() == "":
        return "Вы не ввели имени"

    try:
        with open("users.txt", "r", encoding="utf-8") as file:
            for line in file:
                part = line.split(",")
                first_part = part[0]
                user_name = first_part.split(":")[1].strip()
                if name == user_name:
                    return line.strip()             

    except FileNotFoundError:
        return "Файл не найден!"

    return "Такого имени нет"


def delete_user(name):
    users = []
    found = False

    if name.strip() == "":
        return "Нужно ввести имя"

    try:
        with open("users.txt", "r", encoding="utf-8") as file:
            for line in file:
                    part = line.split(",")
                    first_part = part[0]
                    user_name = first_part.split(":")[1].strip()
                    if user_name != name:
                        users.append(line) 
                    else:
                        found = True                                       

        if not found:
            return "Такого имени нет"

        with open("users.txt", "w", encoding="utf-8") as file:
            for user in users:
                file.write(user)

    except FileNotFoundError:
        return "Такого файла нет"
    
    return "Пользователь удален!"

