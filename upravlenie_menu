
def add_user(name, age):
    name = name.strip()
    if name == "":
        return "Имя не может быть пустым"

    if age < 1 or age > 120:
        return "Возраст должен быть от 1 и меньше 120"
    
    with open("users.txt", "a", encoding="utf-8") as file:
        file.write(f"Имя: {name}, Возраст: {age}\n")

    return "Пользователь сохранен!"

def user_exists(name):
    try:
        with open("users.txt", "r", encoding="utf-8")as file:
            for line in file:
                part = line.split(",")
                first_part = part[0]
                user_name = first_part.split(":")[1].strip()
                
                if name == user_name:
                    return True
    
    except FileNotFoundError:
        return False

    return False

def read_users():
