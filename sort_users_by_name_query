prefix = input("Введите начало имени: ")

def search_users_by_name(prefix):

    prefix = prefix.strip()

    # проверяем на пустое имя в запросе
    if prefix == "":
        return "Введите начало имени для поиска"

    users = []


    try:
        with open("users.txt", "r", encoding="utf-8") as file:
            for line in file:
                part = line.split(",")
                user_name = part[0].split(":")[1].strip()

                if user_name.lower().startswith(prefix.lower()):
                    users.append(line.strip())


    except FileNotFoundError:
        return "Файл не найден"

    return users
  

print(search_users_by_name(prefix))
