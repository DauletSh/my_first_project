def user_statistics():

    count = 0
    total_age = 0
    min_age = None
    max_age = None
    min_name = None
    max_name = None

    try:
        with open("users.txt", "r", encoding="utf-8") as file:
            
            for line in file:
                part = line.split(",")
                first_part = part[0]
                user_name = first_part.split(":")[1].strip()
                age = int(part[1].split(":")[1].strip())

                count +=1
                total_age += age


                if min_age is None or age <min_age:
                    min_age = age
                    min_name = user_name
                if max_age is None or age > max_age:
                    max_age = age
                    max_name = user_name
    

    except FileNotFoundError:
        return "Файл не найден"

    if count == 0:
        return "Список пуст"

    average_age = total_age/count
    
    return(
        f"Количество пользователей: {count}\n"
        f"Самый младший: {min_name}, {min_age} лет\n"
        f"Самый старший: {max_name}, {max_age} лет\n"
        f"Средний возрас: {average_age:.1f} лет"
        ) 

print(user_statistics())
