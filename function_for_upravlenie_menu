def find_users_older_than(min_age):
    users = []

    try:
        with open("users.txt", "r", encoding="utf-8") as file:
            for line in file:
                part = line.split(",")
                age = int(part[1].split(":")[1].strip())

                if age > min_age:
                    users.append(line.strip())

    except FileNotFoundError:
        return "Файл не найден."

    return users

print(find_users_older_than(20))
print(find_users_older_than(30))
print(find_users_older_than(50))


